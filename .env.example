# Server Configuration
PORT=3000

# LLM Provider Configuration
# Options: simulator | gemini | openai
LLM_PROVIDER=simulator

# Optional API Keys (Leave blank to use the high-fidelity built-in clinical triage simulator)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model overrides (optional)
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
